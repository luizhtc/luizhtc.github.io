---
---
<header>
  <div class="topbar">
    <a href="/" class="logo" aria-label="Página inicial">
      <img src="/favicon.ico" alt="" />
      <div class="logo-text">luizhtc GitHub User Page</div>
    </a>

    <div class="header-actions">
      <a href="https://github.com/luizhtc/luizhtc.github.io" target="_blank" rel="noopener noreferrer" class="repository-link" aria-label="Ver repositório deste site">
        <span class="material-symbols-outlined">commit</span>
      </a>
    </div>
  </div>
</header>

<style>
  header {
    height: var(--topbar-h);
    flex-shrink: 0;
    background-color: var(--topbar-bg);
    padding: 0 14px;
    border-bottom: 1px solid black;
  }

  .topbar {
    height: var(--topbar-h);
    display: flex;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    height: 50px;
    padding-right: 8px;
  }

  .logo-text {
    color: var(--text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .repository-link {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: lightgray;
    text-decoration: none;
    color: black;
    border: 1px solid #f0f0f2;
    border-radius: 4px;
    margin: 0 2px;
    padding: 4px 6px;
  }

  .material-symbols-outlined {
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
  }
</style>
